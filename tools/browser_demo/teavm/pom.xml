<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.belvoice</groupId><artifactId>browser-g2p</artifactId><version>0.1.0</version>
  <properties><maven.compiler.release>21</maven.compiler.release><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
  <dependencies>
    <dependency><groupId>org.teavm</groupId><artifactId>teavm-classlib</artifactId><version>0.16.0</version></dependency>
    <dependency><groupId>org.teavm</groupId><artifactId>teavm-jso-apis</artifactId><version>0.16.0</version></dependency>
  </dependencies>
  <build>
    <sourceDirectory>${project.basedir}/generated</sourceDirectory>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.1</version></plugin>
      <plugin>
        <groupId>org.teavm</groupId><artifactId>teavm-maven-plugin</artifactId><version>0.16.0</version>
        <executions><execution><goals><goal>compile</goal></goals><phase>process-classes</phase></execution></executions>
        <configuration>
          <mainClass>org.belvoice.browser.BrowserG2P</mainClass>
          <targetType>JAVASCRIPT</targetType><jsModuleType>ES2015</jsModuleType>
          <targetDirectory>${project.basedir}/../../../browser_demo/g2p</targetDirectory>
          <targetFileName>belg2p.mjs</targetFileName>
          <optimizationLevel>ADVANCED</optimizationLevel><minifying>true</minifying>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
